# Hosted provider API keys for real API tests and local development.
# Fill in only the providers you actually plan to use.
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
FIREWORKS_API_KEY=your-fireworks-api-key-here
ZAI_API_KEY=your-zai-api-key-here

# Optional hosted base URL overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Ollama configuration for local integration testing.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_QWEN3=qwen3:0.6b
# OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
# OLLAMA_OPENAI_MODEL=qwen3:0.6b