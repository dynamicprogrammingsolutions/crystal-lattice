{
  "version": 1,
  "env_file": ".env",
  "mcp": {
    "server": "mcp-gsheets",
    "command": "npx",
    "args": [
      "-y",
      "mcp-gsheets@1.10.2"
    ],
    "env": {
      "GOOGLE_APPLICATION_CREDENTIALS": "${env:GOOGLE_APPLICATION_CREDENTIALS}",
      "GOOGLE_PROJECT_ID": "${env:GOOGLE_PROJECT_ID}"
    },
    "startup_timeout_seconds": 60,
    "tool_timeout_seconds": 60
  },
  "roadmaps": {
    "release": {
      "csv": "open-source-and-ios-release.csv",
      "spreadsheet_id": "${env:ROADMAP_RELEASE_SPREADSHEET_ID}",
      "spreadsheet_title": "Roadmap",
      "sheet": "Sheet1"
    }
  }
}