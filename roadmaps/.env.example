# Google service-account credential file used by mcp-gsheets.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Project identifier expected by mcp-gsheets.
GOOGLE_PROJECT_ID=your-google-project-id

# Spreadsheet configured as the release roadmap destination.
ROADMAP_RELEASE_SPREADSHEET_ID=your-google-spreadsheet-id