# Google service-account credential file used by the Sheets API client.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Spreadsheet configured as the release roadmap destination.
ROADMAP_RELEASE_SPREADSHEET_ID=your-google-spreadsheet-id

# Spreadsheet configured as the product-development roadmap destination.
ROADMAP_PRODUCT_SPREADSHEET_ID=your-google-spreadsheet-id