{
  "name": "@crystal-lattice/frontend-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "integration:backend": "RUN_BACKEND_INTEGRATION=1 vitest run src/integration/__tests__/backend.integration.test.ts",
    "integration:backend:openai": "RUN_BACKEND_OPENAI_INTEGRATION=1 vitest run src/integration/__tests__/backend.openai.integration.test.ts",
    "integration:backend:openrouter-images": "RUN_BACKEND_OPENROUTER_INTEGRATION=1 vitest run src/integration/__tests__/backend.image_attachments.integration.test.ts",
    "integration:backend:openrouter:mcp": "RUN_BACKEND_OPENROUTER_INTEGRATION=1 vitest run src/integration/__tests__/backend.codex_mcp.integration.test.ts",
    "integration:bridge": "RUN_BRIDGE_E2E_INTEGRATION=1 vitest run src/integration/__tests__/bridge.e2e.integration.test.ts",
    "integration:bridge:aws:fargate-secure": "RUN_BRIDGE_E2E_INTEGRATION=1 RUN_AWS_BRIDGE_TESTS=1 BRIDGE_E2E_MODE=aws-secure vitest run src/integration/__tests__/bridge.e2e.integration.test.ts",
    "integration:bridge:aws:fargate-public": "RUN_BRIDGE_E2E_INTEGRATION=1 RUN_AWS_BRIDGE_TESTS=1 BRIDGE_E2E_MODE=aws-public-task vitest run src/integration/__tests__/bridge.e2e.integration.test.ts",
    "integration:bridge:aws:ec2": "RUN_BRIDGE_E2E_INTEGRATION=1 RUN_AWS_BRIDGE_TESTS=1 BRIDGE_E2E_MODE=aws-ec2-secure vitest run src/integration/__tests__/bridge.e2e.integration.test.ts",
    "integration:cloud": "RUN_CLOUD_ORCHESTRATOR_E2E=1 vitest run src/integration/__tests__/cloud-orchestrator.e2e.integration.test.ts",
    "integration:cloud:openrouter": "RUN_CLOUD_ORCHESTRATOR_E2E=1 RUN_CLOUD_ORCHESTRATOR_OPENROUTER_E2E=1 vitest run src/integration/__tests__/cloud-orchestrator.e2e.integration.test.ts",
    "integration:cloud:codex": "RUN_CLOUD_ORCHESTRATOR_E2E=1 RUN_CLOUD_ORCHESTRATOR_CODEX_DEFAULT_CONFIG_E2E=1 vitest run src/integration/__tests__/cloud-orchestrator.e2e.integration.test.ts",
    "integration:cloud:aws": "RUN_CLOUD_ORCHESTRATOR_E2E=1 RUN_AWS_CLOUD_ORCHESTRATOR_TESTS=1 CLOUD_ORCHESTRATOR_E2E_MODE=aws-ec2-cloudfront vitest run src/integration/__tests__/cloud-orchestrator.e2e.integration.test.ts",
    "integration:cloud:aws:codex": "RUN_CLOUD_ORCHESTRATOR_E2E=1 RUN_AWS_CLOUD_ORCHESTRATOR_TESTS=1 CLOUD_ORCHESTRATOR_E2E_MODE=aws-ec2-cloudfront RUN_CLOUD_ORCHESTRATOR_CODEX_DEFAULT_CONFIG_EC2_E2E=1 vitest run src/integration/__tests__/cloud-orchestrator.e2e.integration.test.ts",
    "integration:cloud:aws:build": "sh -c 'cd ../../cloud-orchestrator && RUN_AWS_CLOUD_ORCHESTRATOR_TESTS=1 ./deploy/aws-ec2/build.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\" --json'",
    "integration:cloud:aws:status": "sh -c 'cd ../../cloud-orchestrator && ./deploy/aws-ec2/status.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:cloud:aws:down": "sh -c 'cd ../../cloud-orchestrator && RUN_AWS_CLOUD_ORCHESTRATOR_TESTS=1 ./deploy/aws-ec2/down.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:cloud:aws:down:builder": "sh -c 'stack=\"${AWS_STACK_NAME:?Set AWS_STACK_NAME}-builder\"; region=\"${AWS_REGION:-us-east-1}\"; if aws --region \"$region\" cloudformation describe-stacks --stack-name \"$stack\" >/dev/null 2>&1; then aws --region \"$region\" cloudformation delete-stack --stack-name \"$stack\" && aws --region \"$region\" cloudformation wait stack-delete-complete --stack-name \"$stack\"; else echo \"Builder stack not found: $stack\"; fi'",
    "integration:cloud:aws:list": "sh -c 'aws --region \"${AWS_REGION:-us-east-1}\" cloudformation describe-stacks --query \"Stacks[?starts_with(StackName, '\\''crystal-lattice-cloud-orchestrator'\\'')].[StackName,StackStatus]\" --output table'",
    "integration:bridge:aws:fargate-secure:status": "sh -c 'cd ../../bridge-elixir && ./deploy/aws-fargate/status.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:fargate-secure:down": "sh -c 'cd ../../bridge-elixir && RUN_AWS_BRIDGE_TESTS=1 ./deploy/aws-fargate/down.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:fargate-public:status": "sh -c 'cd ../../bridge-elixir && ./deploy/aws-fargate/status.sh --profile public-task --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:fargate-public:down": "sh -c 'cd ../../bridge-elixir && RUN_AWS_BRIDGE_TESTS=1 ./deploy/aws-fargate/down.sh --profile public-task --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:ec2:build": "sh -c 'cd ../../bridge-elixir && RUN_AWS_BRIDGE_TESTS=1 ./deploy/aws-ec2/build.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\" --json'",
    "integration:bridge:aws:ec2:status": "sh -c 'cd ../../bridge-elixir && ./deploy/aws-ec2/status.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:ec2:down": "sh -c 'cd ../../bridge-elixir && RUN_AWS_BRIDGE_TESTS=1 ./deploy/aws-ec2/down.sh --profile secure --stack-name \"${AWS_STACK_NAME:?Set AWS_STACK_NAME}\" --region \"${AWS_REGION:-us-east-1}\"'",
    "integration:bridge:aws:ec2:down:builder": "sh -c 'stack=\"${AWS_STACK_NAME:?Set AWS_STACK_NAME}-builder\"; region=\"${AWS_REGION:-us-east-1}\"; if aws --region \"$region\" cloudformation describe-stacks --stack-name \"$stack\" >/dev/null 2>&1; then aws --region \"$region\" cloudformation delete-stack --stack-name \"$stack\" && aws --region \"$region\" cloudformation wait stack-delete-complete --stack-name \"$stack\"; else echo \"Builder stack not found: $stack\"; fi'",
    "integration:bridge:aws:list": "sh -c 'aws --region \"${AWS_REGION:-us-east-1}\" cloudformation describe-stacks --query \"Stacks[?starts_with(StackName, '\\''crystal-lattice-bridge'\\'')].[StackName,StackStatus]\" --output table'"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
