{
  "plugin_cache_dir": "~/.crystal/cache/plugins",
  "plugins": [
    "path:${env:BUILTIN_PLUGINS}/openrouter",
    "path:${env:BUILTIN_PLUGINS}/openai_responses",
    "path:${env:BUILTIN_PLUGINS}/interceptor-tool",
    "plugins.tool_call_preview_feature.ToolCallPreviewFeature",
    "plugins.tool_gating_feature.ToolGatingFeature",
    "plugins.tool_interceptor_metadata_preserver.ToolInterceptorMetadataPreserver"
  ],
  "providers": {
    "openrouter": {
      "provider": "openrouter",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "enable_reasoning": true,
      "timeout": 120
    },
    "openai": {
      "provider": "openai_responses",
      "api_key": "${env:OPENAI_API_KEY}",
      "base_url": "https://api.openai.com/v1",
      "enable_reasoning": true,
      "auth_mode": "auto",
      "timeout": 120
    }
  },
  "agents": {
    "intercept-openrouter": {
      "provider": "openrouter",
      "model": "openai/gpt-5.4-nano"
    },
    "intercept-openai": {
      "provider": "openai",
      "model": "gpt-5-mini"
    }
  }
}