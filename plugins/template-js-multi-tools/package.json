{
  "name": "template-js-multi-tools",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outdir=dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "agent": {
    "kinds": ["tools"],
    "tools": [
      { "id": "template_js_echo", "entry": "dist/index.js", "export": "echoTool" },
      { "id": "template_js_reverse", "entry": "dist/index.js", "export": "reverseTool" }
    ]
  }
}
