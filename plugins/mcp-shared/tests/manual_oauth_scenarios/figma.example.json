{
  "id": "figma-remote-mcp",
  "description": "Manual Figma remote MCP OAuth flow using the same public-client shape as Gemini CLI's Figma extension path.",
  "mcp_oauth_manual": {
    "server_name": "figma",
    "connection_id": "manual-connection",
    "session_id": "manual-session",
    "plugin_id": "mcp_runtime_app",
    "action_id": "mcp_complete_login",
    "callback_port": 41793,
    "finish_token_endpoint_auth_method": "client_secret_post",
    "finish_include_resource": true
  },
  "mcp_servers": {
    "figma": {
      "enabled": true,
      "transport": "http",
      "url": "https://mcp.figma.com/mcp",
      "startup_timeout_seconds": 30,
      "oauth": {
        "client_name": "Gemini CLI MCP Client",
        "client_uri": null,
        "software_id": null,
        "software_version": null,
        "token_endpoint_auth_method": "none",
        "scope": "mcp:connect",
        "redirect_uri": "http://localhost:{port}/oauth/callback"
      }
    }
  }
}