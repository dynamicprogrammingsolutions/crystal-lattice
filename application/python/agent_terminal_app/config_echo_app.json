{
  "plugin_cache_dir": "~/.crystal/cache/plugins",
  "application": {
    "tool_output_line_limit": 100,
    "tool_output_char_limit": 8000,
    "tool_output_short_char_limit": 200,
    "tool_output_short_one_line": true,
    "tool_output_short_line_limit": 20
  },
  "providers": {
    "echo_openai_like_default": {
      "provider": "echo_openai_like",
      "model": "echo-test-1",
      "timeout": 60
    }
  },
  "plugins": [
    "plugins.echo_openai_like_provider.EchoOpenAILikeProvider",
    "plugins.delay_extension.DelayExtension",
    "plugins.random_failure_extension.RandomFailureExtension",
    "plugins.echo_provider_metadata_preserver.EchoProviderMetadataPreserver"
  ],
  "agents": {
    "default": {
      "provider": "echo_openai_like_default"
    },
    "alt": {
      "provider": "echo_openai_like_default"
    }
  }
}
