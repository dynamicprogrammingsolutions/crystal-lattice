{
  "plugin_cache_dir": "~/.crystal/cache/plugins",
  "application": {
    "tool_output_line_limit": 100,
    "tool_output_char_limit": 8000,
    "tool_output_short_char_limit": 200,
    "tool_output_short_one_line": false,
    "tool_output_short_line_limit": 20,
    "session_actions": {
      "allow_delete": true
    },
    "session_title_metadata_key": "title",
    "session_subtitle_metadata_key": "subtitle",
    "summarize_range_agent_id": "reasoning",
    "summarize_range_prompt": "Summarize the selected part of this conversation in a concise paragraph.",
    "summarize_range_settings_overrides": {
      "reasoningEffort": "low"
    },
    "generate_title_agent_id": "reasoning",
    "generate_title_prompt_template": "Generate a short (max 8 words) title for this conversation. If appropriate, also provide a one-line plain-text description on a second line.",
    "generate_title_max_messages": 50,
    "generate_title_settings_overrides": {
      "reasoningEffort": "low"
    },
    "session_pinned_metadata_key": "pinned",
    "generate_title_enable_description": true,
    "generate_title_system_message": "You are a title and description generator. Respond with exactly two non-empty lines. Line 1 must be only a concise title for the conversation (maximum 8 words). Line 2 must be only a single-sentence plain-text description of the conversation. Do not include labels, numbering, bullet points, or any extra text before or after these two lines.",
    "generate_title_debug_save_session": true
  },
  "providers": {
    "openrouter_tools": {
      "provider": "openrouter",
      "model": "openai/gpt-5-mini",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "timeout": 300,
      "allowed_paths": ["."],
      "max_file_size": 5242880,
      "working_directory": ".",
      "enable_reasoning": true,
      "reasoning_effort": "low",
      "system_message_enabled": true,
      "system_message": "You are a helpful coding assistant. Respond concisely."
    }
  },
  "plugins": [
    "path:../../../plugins/openrouter",
    "path:../../../plugins/codex-tools",
    "path:../../../plugins/feature-system-message",
    "path:../../../plugins/feature-file-context",
    "path:../../../plugins/feature-web-context",
    "path:../../../plugins/session-actions-app",
    "path:../../../plugins/summarize-range-app",
    "path:../../../plugins/session-title-app",
    "path:../../../plugins/generate-title-app",
    "path:../../../plugins/session-timestamp-meta-app",
    "path:../../../plugins/session-message-count-meta-app",
    "path:../../../plugins/session-pinned-app"
  ],
  "agents": {
    "default": {
      "provider": "openrouter_tools",
      "enable_delay_extension": false,
      "delay_seconds": 10,
      "enable_random_failure": false,
      "random_failure_every": 3
    },
    "reasoning": {
      "provider": "openrouter_tools",
      "reasoning_effort": "medium"
    }
  }
}
