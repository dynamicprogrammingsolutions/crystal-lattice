#!/usr/bin/env bash
# Purpose: Export only the committed local HEAD for clean cloud sessions that
# sync back through branch import without including local dirty changes.
# Required env vars: LOCAL_WORKSPACE_DIR, TRANSFER_DIR.
# Inputs: Git worktree at LOCAL_WORKSPACE_DIR.
# Outputs: TRANSFER_DIR/.cloud-agent/base-commit and repo.bundle.
# Customization: Keep this bundled script for clean-head transfer; use
# .cloud-agent/local-stage only for explicit repo-local additions.
set -euo pipefail

: "${LOCAL_WORKSPACE_DIR:?}"
: "${TRANSFER_DIR:?}"

cd "${LOCAL_WORKSPACE_DIR}"
payload_dir="${TRANSFER_DIR}/.cloud-agent"
mkdir -p "${payload_dir}"

git rev-parse --show-toplevel >/dev/null
base_commit="$(git rev-parse HEAD)"
printf '%s\n' "${base_commit}" > "${payload_dir}/base-commit"
git bundle create "${payload_dir}/repo.bundle" HEAD