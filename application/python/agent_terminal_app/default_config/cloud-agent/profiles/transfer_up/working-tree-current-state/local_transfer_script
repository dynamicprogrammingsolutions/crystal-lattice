#!/usr/bin/env bash
# Purpose: Export the local committed HEAD plus staged, unstaged, and untracked
# changes as a tar archive and binary patch for the default patch round-trip flow.
# Required env vars: LOCAL_WORKSPACE_DIR, TRANSFER_DIR.
# Inputs: Git worktree at LOCAL_WORKSPACE_DIR.
# Outputs: TRANSFER_DIR/.cloud-agent/project.tar and working.patch.
# Customization: Keep this bundled script for standard git patch transfer; use
# .cloud-agent/local-stage for repo-local additions such as .env files.
set -euo pipefail

: "${LOCAL_WORKSPACE_DIR:?}"
: "${TRANSFER_DIR:?}"

cd "${LOCAL_WORKSPACE_DIR}"
payload_dir="${TRANSFER_DIR}/.cloud-agent"
mkdir -p "${payload_dir}"

git rev-parse --show-toplevel >/dev/null
git archive --format=tar --output="${payload_dir}/project.tar" HEAD

index_file="${payload_dir}/transfer.index"
rm -f "${index_file}"
GIT_INDEX_FILE="${index_file}" git read-tree HEAD
GIT_INDEX_FILE="${index_file}" git add -A -- . ':(exclude).cloud-agent'
GIT_INDEX_FILE="${index_file}" git diff --cached --binary HEAD > "${payload_dir}/working.patch"
rm -f "${index_file}"