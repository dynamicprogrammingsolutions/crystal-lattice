#!/usr/bin/env bash
# Purpose: Export the cloud workspace delta as a binary patch against the last
# prepared cloud git baseline for the default patch sync-down flow.
# Required env vars: CLOUD_WORKSPACE_DIR, TRANSFER_DIR.
# Inputs: Prepared git workspace at CLOUD_WORKSPACE_DIR.
# Outputs: TRANSFER_DIR/.cloud-agent/cloud.patch.
# Customization: Keep this bundled script for standard patch sync-down.
set -euo pipefail

: "${CLOUD_WORKSPACE_DIR:?}"
: "${TRANSFER_DIR:?}"

payload_dir="${TRANSFER_DIR}/.cloud-agent"
mkdir -p "${payload_dir}"

git config --global --add safe.directory "${CLOUD_WORKSPACE_DIR}" >/dev/null 2>&1 || true

cd "${CLOUD_WORKSPACE_DIR}"
git add -A
git diff --cached --binary HEAD > "${payload_dir}/cloud.patch"