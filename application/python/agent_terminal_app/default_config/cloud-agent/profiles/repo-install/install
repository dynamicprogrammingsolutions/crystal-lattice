#!/usr/bin/env bash
set -euo pipefail

: "${CLOUD_WORKSPACE_DIR:?}"
: "${TRANSFER_DIR:?}"
: "${TRANSFER_STAGE_DIR:?}"

hook_candidates=(
  "${CLOUD_WORKSPACE_DIR}/.cloud-agent/install-cloud"
  "${CLOUD_WORKSPACE_DIR}/.cloud-agent/install-cloud.sh"
  "${CLOUD_WORKSPACE_DIR}/.cloud-agent/install"
  "${CLOUD_WORKSPACE_DIR}/.cloud-agent/install.sh"
)

for hook in "${hook_candidates[@]}"; do
  if [ -f "${hook}" ] && [ -x "${hook}" ]; then
    exec "${hook}"
  fi
  if [ -f "${hook}" ]; then
    exec bash "${hook}"
  fi
done