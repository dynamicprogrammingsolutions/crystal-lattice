#!/usr/bin/env bash
set -euo pipefail

: "${LOCAL_WORKSPACE_DIR:?}"
: "${TRANSFER_DIR:?}"
: "${TRANSFER_STAGE_DIR:?}"

mkdir -p "${TRANSFER_STAGE_DIR}"

hook_candidates=(
  "${LOCAL_WORKSPACE_DIR}/.cloud-agent/local-stage"
  "${LOCAL_WORKSPACE_DIR}/.cloud-agent/local-stage.sh"
)

for hook in "${hook_candidates[@]}"; do
  if [ -f "${hook}" ] && [ -x "${hook}" ]; then
    exec "${hook}"
  fi
  if [ -f "${hook}" ]; then
    exec bash "${hook}"
  fi
done