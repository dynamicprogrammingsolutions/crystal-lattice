{
  "plugin_cache_dir": ".plugin_cache/plugins",
  "providers": {
    "ollama_tools": {
      "provider": "openai_compatible",
      "model": "qwen3:0.6b",
      "base_url": "http://localhost:11434/v1",
      "timeout": 180,
      "allowed_paths": ["."],
      "working_directory": ".",
      "node_tool_stream_parts": true
    }
  },
  "plugins": [
    "plugins.openai_provider.OpenAICompatibleProvider",
    "plugins.openai_tools_extension.OpenAIToolsExtension",
    "plugins.ollama_thinking_extension.OllamaThinkingExtension",
    "node:../../../plugins/js-fs-tools"
  ],
  "agents": {
    "default": {
      "provider": "ollama_tools"
    }
  }
}
