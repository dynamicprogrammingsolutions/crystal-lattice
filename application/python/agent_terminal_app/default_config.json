{
  "plugin_cache_dir": "~/.crystal/cache/plugins",
  "application": {
    "tool_output_line_limit": 50,
    "tool_output_short_char_limit": 200,
    "tool_output_short_one_line": false,
    "tool_output_short_line_limit": 10,
    "session_actions": {
      "allow_delete": true
    },
    "session_title_metadata_key": "title",
    "session_subtitle_metadata_key": "subtitle",
    "session_pinned_metadata_key": "pinned",
    "cloud_agent": {
      "orchestrator_url": "${env:CLOUD_ORCHESTRATOR_URL}",
      "orchestrator_token": "${env:CLOUD_ORCHESTRATOR_TOKEN}",
      "workspace_dir": ".",
      "transfer_method": "managed_ssh",
      "local_transfer_script": ".cloud-agent/transfer-up",
      "cloud_setup_script": ".cloud-agent/setup-cloud",
      "cloud_export_script": ".cloud-agent/export-cloud",
      "local_apply_script": ".cloud-agent/apply-down",
      "managed_ssh": {
        "adapter_script": null,
        "ssh_path": "ssh",
        "rsync_path": "rsync",
        "extra_rsync_args": []
      }
    }
  },
  "providers": {
    "openrouter_tools": {
      "provider": "openrouter",
      "model": "openai/gpt-5.1",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "timeout": 300,
      "allowed_paths": ["."],
      "max_file_size": 5242880,
      "working_directory": ".",
      "enable_reasoning": true,
      "reasoning_effort": "medium",
      "system_message_enabled": true,
      "system_message": "You are a helpful coding assistant. Respond concisely."
    },
    "openrouter_image_generation": {
      "provider": "openrouter_image_generation",
      "model": "black-forest-labs/flux.2-klein-4b",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "timeout": 180,
      "aspect_ratio": "1:1"
    }
  },
  "plugins": [
    "path:${env:BUILTIN_PLUGINS}/openrouter",
    "path:${env:BUILTIN_PLUGINS}/feature-request-options",
    "path:${env:BUILTIN_PLUGINS}/codex-tools",
    "path:${env:BUILTIN_PLUGINS}/feature-system-message",
    "path:${env:BUILTIN_PLUGINS}/feature-file-context",
    "path:${env:BUILTIN_PLUGINS}/feature-web-context",
    "path:${env:BUILTIN_PLUGINS}/timestamp-extension",
    "path:${env:BUILTIN_PLUGINS}/session-actions-app",
    "path:${env:BUILTIN_PLUGINS}/summarize-range-app",
    "path:${env:BUILTIN_PLUGINS}/session-title-app",
    "path:${env:BUILTIN_PLUGINS}/generate-title-app",
    "path:${env:BUILTIN_PLUGINS}/session-timestamp-meta-app",
    "path:${env:BUILTIN_PLUGINS}/session-message-count-meta-app",
    "path:${env:BUILTIN_PLUGINS}/session-pinned-app",
    "path:${env:BUILTIN_PLUGINS}/cloud-agent-app"
  ],
  "agents": {
    "default": {
      "provider": "openrouter_tools",
      "enable_delay_extension": false,
      "delay_seconds": 10,
      "enable_random_failure": false,
      "random_failure_every": 3,
      "file_context_on_the_fly": false
    },
    "reasoning": {
      "provider": "openrouter_tools",
      "reasoning_effort": "medium"
    },
    "openrouter-image": {
      "provider": "openrouter_image_generation"
    }
  }
}
