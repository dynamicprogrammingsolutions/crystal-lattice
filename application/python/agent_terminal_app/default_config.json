{
  "application": {
    "tool_output_short_char_limit": 200,
    "tool_output_short_one_line": false,
    "tool_output_short_line_limit": 20
  },
  "providers": {
    "openrouter_tools": {
      "provider": "openrouter",
      "model": "openai/gpt-5.1",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "timeout": 300,
      "allowed_paths": ["."],
      "max_file_size": 5242880,
      "working_directory": ".",
      "enable_reasoning": true,
      "reasoning_effort": "medium",
      "system_message_enabled": true,
      "system_message": "You are a helpful coding assistant. Respond concisely."
    },
    "openai_compatible": {
      "provider": "openai_compatible",
      "model": "qwen3:0.6b",
      "base_url": "http://localhost:11434/v1"
    }
  },
  "plugins": {
    "providers": ["plugins.openrouter_provider.OpenRouterProvider"],
    "extensions": [
      "plugins.openrouter_reasoning_extension.OpenRouterReasoningExtension",
      "plugins.openrouter_tools_extension.OpenRouterToolsExtension",
      "plugins.openrouter_websearch_extension.OpenRouterWebSearchExtension",
      "plugins.timestamp_extension.TimestampExtension",
      "plugins.delay_extension.DelayExtension",
      "plugins.random_failure_extension.RandomFailureExtension",
      "plugins.openai_tools_extension.OpenAIToolsExtension",
      "plugins.openrouter_usage_extension.OpenRouterUsageExtension"
    ],
    "features": [
      "plugins.system_message_feature.SystemMessageFeature",
      "plugins.file_context_feature.FileContextFeature",
      "plugins.web_context_feature.WebContextFeature"
    ],
    "tools": [
      "plugins.shell_tool.ShellTool",
      "plugins.apply_patch_tool.ApplyPatchTool"
    ]
  },
  "agents": {
    "default": {
      "provider": "openrouter_tools",
      "enable_delay_extension": false,
      "delay_seconds": 10,
      "enable_random_failure": false,
      "random_failure_every": 3,
      "file_context_on_the_fly": false
    },
    "reasoning": {
      "provider": "openrouter_tools",
      "reasoning_effort": "medium"
    }
  }
}
