{
  "plugin_cache_dir": "~/.crystal/cache/plugins",
  "application": {
    "tool_output_line_limit": 50,
    "tool_output_short_char_limit": 200,
    "tool_output_short_one_line": false,
    "tool_output_short_line_limit": 10,
    "session_actions": {
      "allow_delete": true
    },
    "session_title_metadata_key": "title",
    "session_subtitle_metadata_key": "subtitle",
    "session_pinned_metadata_key": "pinned"
  },
  "providers": {
    "openrouter_tools": {
      "provider": "openrouter",
      "model": "openai/gpt-5.1",
      "api_key": "${env:OPENROUTER_API_KEY}",
      "base_url": "https://openrouter.ai/api/v1",
      "timeout": 300,
      "allowed_paths": ["."],
      "max_file_size": 5242880,
      "working_directory": ".",
      "enable_reasoning": true,
      "reasoning_effort": "medium",
      "system_message_enabled": true,
      "system_message": "You are a helpful coding assistant. Respond concisely."
    }
  },
  "plugins": [
    "path:../../../plugins/openrouter::openrouter_plugins",
    "path:../../../plugins/codex-tools::codex_tools",
    "path:../../../plugins/feature-system-message::feature_system_message",
    "path:../../../plugins/feature-file-context::feature_file_context",
    "path:../../../plugins/feature-web-context::feature_web_context",
    "path:../../../plugins/timestamp-extension::timestamp_extension",
    "path:../../../plugins/session-actions-app::session_actions_app",
    "path:../../../plugins/summarize-range-app::summarize_range_app",
    "path:../../../plugins/session-title-app::session_title_app",
    "path:../../../plugins/generate-title-app::generate_title_app",
    "path:../../../plugins/session-timestamp-meta-app::session_timestamp_meta_app",
    "path:../../../plugins/session-message-count-meta-app::session_message_count_meta_app",
    "path:../../../plugins/session-pinned-app::session_pinned_app"
  ],
  "agents": {
    "default": {
      "provider": "openrouter_tools",
      "enable_delay_extension": false,
      "delay_seconds": 10,
      "enable_random_failure": false,
      "random_failure_every": 3,
      "file_context_on_the_fly": false
    },
    "reasoning": {
      "provider": "openrouter_tools",
      "reasoning_effort": "medium"
    }
  }
}
