{
  "name": "CrystalLatticeControlDesktopRN",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "macos": "react-native run-macos",
    "lint": "eslint .",
    "start": "react-native start",
    "rn": "react-native",
    "start-no-cache": "react-native start --reset-cache",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:macos-ui": "FORCE_BUNDLING=1 xcodebuild -workspace macos/CrystalLatticeControlDesktopRN.xcworkspace -scheme CrystalLatticeControlDesktopRN-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' test -only-testing:CrystalLatticeControlDesktopRN-macOSUITests",
    "test:macos-ui:session-filters": "FORCE_BUNDLING=1 xcodebuild -workspace macos/CrystalLatticeControlDesktopRN.xcworkspace -scheme CrystalLatticeControlDesktopRN-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' test -only-testing:CrystalLatticeControlDesktopRN-macOSUITests/SessionFiltersPopoverUITests",
    "test:macos-ui:connections": "FORCE_BUNDLING=1 xcodebuild -workspace macos/CrystalLatticeControlDesktopRN.xcworkspace -scheme CrystalLatticeControlDesktopRN-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' test -only-testing:CrystalLatticeControlDesktopRN-macOSUITests/ConnectionsPanelUITests",
    "test:macos-ui:transcript-range": "CLC_ENABLE_TRANSCRIPT_RANGE_NAVIGATION_HARNESS=1 FORCE_BUNDLING=1 xcodebuild -workspace macos/CrystalLatticeControlDesktopRN.xcworkspace -scheme CrystalLatticeControlDesktopRN-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' test -only-testing:CrystalLatticeControlDesktopRN-macOSUITests/TranscriptRangeNavigationUITests",
    "test:macos-ui:action-display": "CLC_ENABLE_ACTION_DISPLAY_HARNESS=1 FORCE_BUNDLING=1 xcodebuild -workspace macos/CrystalLatticeControlDesktopRN.xcworkspace -scheme CrystalLatticeControlDesktopRN-macOS -configuration Debug -destination 'platform=macOS,arch=arm64' test -only-testing:CrystalLatticeControlDesktopRN-macOSUITests/ActionDisplayWindowUITests",
    "pod-install": "cd macos && pod install && cd .."
  },
  "dependencies": {
    "@crystal-lattice/frontend-rn-components": "file:../../packages/frontend-rn-components",
    "@crystal-lattice/frontend-sdk": "file:../../packages/frontend-sdk",
    "@crystal-lattice/frontend-sdk-react": "file:../../packages/frontend-sdk-react",
    "@crystal-lattice/react-native-mac-text-view": "file:../../packages/react-native-mac-text-view",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.81.6",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-macos": "0.81.8",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-syntax-highlighter": "git+https://github.com/ferenci84/react-native-syntax-highlighter.git#feature/native-line-height",
    "react-native-vector-icons": "^10.2.0",
    "react-syntax-highlighter": "^6.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "@react-native/typescript-config": "0.81.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
