if [ -z "${NODE_BINARY:-}" ]; then
  NVMRC_PATH="$SRCROOT/../../../.nvmrc"
  NODE_VERSION=""
  if [ -f "$NVMRC_PATH" ]; then
    NODE_VERSION="$(tr -d '[:space:]' < "$NVMRC_PATH")"
  fi

  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    if [ -n "$NODE_VERSION" ]; then
      nvm use --silent "$NODE_VERSION" >/dev/null 2>&1 || true
    fi
  fi

  NODE_BINARY="$(command -v node || true)"
  if [ -z "$NODE_BINARY" ] && [ -n "$NODE_VERSION" ]; then
    NVM_NODE="$NVM_DIR/versions/node/$NODE_VERSION/bin/node"
    if [ -x "$NVM_NODE" ]; then
      NODE_BINARY="$NVM_NODE"
    fi
  fi
  if [ -z "$NODE_BINARY" ] && [ -x /opt/homebrew/bin/node ]; then
    NODE_BINARY=/opt/homebrew/bin/node
  fi
  if [ -z "$NODE_BINARY" ] && [ -x /usr/local/bin/node ]; then
    NODE_BINARY=/usr/local/bin/node
  fi
fi

export NODE_BINARY
