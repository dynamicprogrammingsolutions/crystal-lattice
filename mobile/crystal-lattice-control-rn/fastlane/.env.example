APP_IDENTIFIER=com.dynamicprogrammingsolutions.crystallatticecontrolrn
APPLE_TEAM_ID=73Q43R2PD4
APP_STORE_APPLE_ID=6798401926

# Private git repository used by fastlane match.
MATCH_GIT_URL=git@github.com:dynamicprogrammingsolutions/crystal-lattice-ios-signing.git
MATCH_PASSWORD=replace-with-a-strong-random-password
MATCH_READONLY=true

# App Store Connect API key. Use a local .p8 path or base64 key content.
APP_STORE_CONNECT_KEY_ID=replace-with-key-id
APP_STORE_CONNECT_ISSUER_ID=replace-with-issuer-id
APP_STORE_CONNECT_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8
# APP_STORE_CONNECT_KEY_CONTENT=replace-with-base64-p8-content
# APP_STORE_CONNECT_KEY_CONTENT_BASE64=true

# Optional release controls.
# IOS_BUILD_NUMBER=2
# TESTFLIGHT_CHANGELOG=Internal TestFlight build
# SKIP_MOBILE_VERIFICATION=false
# SKIP_WAITING_FOR_BUILD_PROCESSING=false