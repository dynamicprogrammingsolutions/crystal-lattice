{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"],
      "react-native": ["node_modules/react-native"],
      "@crystal-lattice/frontend-sdk": ["../../packages/frontend-sdk/src"],
      "@crystal-lattice/frontend-sdk-react": ["../../packages/frontend-sdk-react/src"],
      "@crystal-lattice/frontend-rn-components": ["../../packages/frontend-rn-components/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "__integration__"]
}
