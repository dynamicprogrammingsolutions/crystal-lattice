{
  "name": "crystal-lattice-control-rn",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "android": "react-native run-android --port 8082",
    "pod-install": "python3 scripts/prepare_ios_python_runtime.py && cd ios && pod install",
    "ios": "react-native run-ios",
    "ios:icons": "scripts/generate_ios_app_icons.sh",
    "ios-device": "react-native run-ios --device --port 8082",
    "lint": "eslint .",
    "start": "react-native start --port 8082",
    "test": "jest",
    "test:components": "jest",
    "test:components:integration": "jest --config jest.integration.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "detox:build:ios": "npm run pod-install && detox build -c ios.sim.release",
    "detox:test:ios": "detox test -c ios.sim.release --cleanup",
    "detox:build:android": "detox build -c android.emu.e2e",
    "detox:test:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e --cleanup",
    "detox:test:bridge-transport:ios": "detox test -c ios.sim.release e2e/bridgeTransportMode.e2e.test.ts --cleanup",
    "detox:test:bridge-transport:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/bridgeTransportMode.e2e.test.ts --cleanup",
    "detox:test:connections-settings:ios": "detox test -c ios.sim.release e2e/connectionsSettings.e2e.test.ts --cleanup",
    "detox:test:connections-settings:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/connectionsSettings.e2e.test.ts --cleanup",
    "detox:test:transcript:ios": "detox test -c ios.sim.release e2e/transcriptScroll.e2e.test.ts --cleanup",
    "detox:test:transcript:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/transcriptScroll.e2e.test.ts --cleanup",
    "detox:test:transcript-range:ios": "detox test -c ios.sim.release e2e/transcriptRangeNavigation.e2e.test.ts --cleanup",
    "detox:test:transcript-range:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/transcriptRangeNavigation.e2e.test.ts --cleanup",
    "detox:test:session-list:ios": "detox test -c ios.sim.release e2e/sessionList.e2e.test.ts --cleanup",
    "detox:test:session-list:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/sessionList.e2e.test.ts --cleanup",
    "detox:test:rich-session-ui:ios": "detox test -c ios.sim.release e2e/richSessionUi.e2e.test.ts --cleanup",
    "detox:test:rich-session-ui:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/richSessionUi.e2e.test.ts --cleanup",
    "detox:test:home:ios": "detox test -c ios.sim.release e2e/home.e2e.test.ts --cleanup",
    "detox:test:home:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/home.e2e.test.ts --cleanup",
    "detox:test:notification-banner:ios": "detox test -c ios.sim.release e2e/notificationBanner.e2e.test.ts --cleanup",
    "detox:test:notification-banner:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/notificationBanner.e2e.test.ts --cleanup",
    "detox:test:selectable-code-block:ios": "detox test -c ios.sim.release e2e/selectableCodeBlock.e2e.test.ts --cleanup",
    "detox:test:selectable-code-block:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/selectableCodeBlock.e2e.test.ts --cleanup",
    "detox:test:ordered-list:ios": "detox test -c ios.sim.release e2e/orderedListMarkdown.e2e.test.ts --cleanup",
    "detox:test:ordered-list:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/orderedListMarkdown.e2e.test.ts --cleanup",
    "detox:test:embedded-python-runtime:ios": "detox test -c ios.sim.release e2e/embeddedPythonRuntime.e2e.test.ts --cleanup",
    "detox:test:embedded-python-web-fetch:ios": "detox test -c ios.sim.release e2e/embeddedPythonRuntimeWebFetch.e2e.test.ts --cleanup",
    "detox:test:embedded-python-ollama:ios": "detox test -c ios.sim.release e2e/embeddedPythonRuntimeOllama.e2e.test.ts --cleanup",
    "detox:test:embedded-python-setup:ios": "detox test -c ios.sim.release e2e/embeddedPythonRuntimeSetup.e2e.test.ts --cleanup",
    "detox:test:embedded-python-background:ios": "detox test -c ios.sim.release e2e/embeddedPythonRuntimeBackground.e2e.test.ts --cleanup",
    "detox:test:embedded-provider-matrix:ios": "detox test -c ios.sim.release e2e/embeddedProviderRealApiMatrix.e2e.test.ts --cleanup",
    "detox:test:embedded-chatgpt-login:ios": "detox test -c ios.sim.release e2e/embeddedChatGPTLogin.e2e.test.ts --cleanup",
    "detox:test:notification-ui-effects:ios": "detox test -c ios.sim.release e2e/notificationUiEffects.e2e.test.ts --cleanup",
    "detox:test:notification-ui-effects:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/notificationUiEffects.e2e.test.ts --cleanup",
    "detox:test:website-visual:ios": "detox test -c ios.sim.release e2e/websiteVisualCapture.e2e.test.ts --cleanup",
    "detox:test:website-visual:android": "scripts/prepare_android_detox_emulator.sh && detox test -c android.emu.e2e e2e/websiteVisualCapture.e2e.test.ts --cleanup",
    "detox:capture:website-visual:ios": "npm run detox:build:ios && npm run detox:test:website-visual:ios",
    "detox:capture:website-visual:android": "npm run detox:build:android && npm run detox:test:website-visual:android",
    "tsc": "tsc --noEmit",
    "ios:prepare-python": "python3 scripts/prepare_ios_python_runtime.py"
  },
  "dependencies": {
    "@crystal-lattice/frontend-rn-components": "file:../../packages/frontend-rn-components",
    "@crystal-lattice/frontend-sdk": "file:../../packages/frontend-sdk",
    "@crystal-lattice/frontend-sdk-react": "file:../../packages/frontend-sdk-react",
    "@ferenci84/react-native-selectable-code-block": "git+https://github.com/ferenci84/react-native-selectable-code-block.git#initial-token-native-component",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native/new-app-screen": "0.82.1",
    "lowlight": "^1.9.2",
    "markdown-it": "^10.0.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-enriched-markdown": "git+https://github.com/ferenci84/react-native-enriched-markdown.git#d782800cf5ec0f6e3a3c957719a7eda384abf4d5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-share": "^12.2.6",
    "react-native-svg": "^15.15.5",
    "react-native-syntax-highlighter": "git+https://github.com/ferenci84/react-native-syntax-highlighter.git#feature/native-line-height",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "^0.8.1",
    "react-native-zeroconf": "^0.13.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.1.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
