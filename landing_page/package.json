{
  "name": "crystal-lattice-landing",
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "yarn dev:production",
    "dev:production": "node scripts/run-site-variant.mjs production astro dev",
    "dev:staging": "node scripts/run-site-variant.mjs staging astro dev",
    "build": "yarn build:production",
    "build:production": "node scripts/run-site-variant.mjs production astro build",
    "build:staging": "node scripts/run-site-variant.mjs staging astro build",
    "preview": "yarn preview:production",
    "preview:production": "node scripts/run-site-variant.mjs production astro preview",
    "preview:staging": "node scripts/run-site-variant.mjs staging astro preview",
    "test:analytics": "node --test tests/analytics.test.mjs",
    "test:content": "node --test tests/home-content.test.mjs tests/desktop-release-link.test.mjs tests/site-variants.test.mjs",
    "visual-assets": "node scripts/visual-assets/cli.mjs",
    "visual-assets:list": "node scripts/visual-assets/cli.mjs list",
    "visual-assets:capture": "node scripts/visual-assets/cli.mjs capture",
    "visual-assets:promote-source": "node scripts/visual-assets/cli.mjs promote-source",
    "visual-assets:check": "node scripts/visual-assets/cli.mjs check",
    "visual-assets:inspect": "node scripts/visual-assets/cli.mjs inspect",
    "visual-assets:update": "node scripts/visual-assets/cli.mjs update",
    "review:homepage-visuals": "node scripts/build-homepage-visual-review.mjs",
    "review:product-overview": "node scripts/visual-assets/product-overview-composition.mjs",
    "test:visual-assets": "node --test tests/visual-assets/*.test.mjs",
    "test:visual-session": "python -m pytest tests/visual-assets-python/test_session_fixture.py -q",
    "test:visual": "yarn test:visual:staging",
    "test:visual:production": "node scripts/run-site-variant.mjs production playwright test tests/visual/production-homepage.spec.mjs --config=playwright.visual.config.mjs",
    "test:visual:staging": "node scripts/run-site-variant.mjs staging playwright test --config=playwright.visual.config.mjs",
    "test:visual:headed": "node scripts/run-site-variant.mjs staging playwright test --headed --config=playwright.visual.config.mjs",
    "verify:visual": "yarn test:visual-assets && yarn visual-assets:check && yarn test:visual"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^5.8.0",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  }
}
