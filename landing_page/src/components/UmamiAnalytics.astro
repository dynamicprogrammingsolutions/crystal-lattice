---
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const APPROVED_SCRIPT_URL = 'https://stats.dynamicprogrammingsolutions.com/insight.js';
const APPROVED_DOMAIN = 'crystallattice.dev';

const scriptUrl = import.meta.env.PUBLIC_CRYSTAL_LATTICE_UMAMI_SCRIPT_URL?.trim() ?? '';
const websiteId = import.meta.env.PUBLIC_CRYSTAL_LATTICE_UMAMI_LANDING_ID?.trim() ?? '';
const enabled = scriptUrl === APPROVED_SCRIPT_URL && UUID_PATTERN.test(websiteId);
---

{enabled && (
  <>
    <script is:inline defer src="/assets/js/umami-sanitizer.js"></script>
    <script
      is:inline
      defer
      src={scriptUrl}
      data-website-id={websiteId}
      data-domains={APPROVED_DOMAIN}
      data-do-not-track="true"
      data-exclude-search="true"
      data-exclude-hash="true"
      data-performance="true"
      data-before-send="crystalLatticeUmamiBeforeSend"
    ></script>
  </>
)}
