---
const { section } = Astro.props;
const methods = Array.isArray(section.methods) ? section.methods : [];
---

<section class="connect" id="connect">
  <div class="container">
    <div class="header">
      <p class="label">{section.eyebrow}</p>
      <h2>{section.title}</h2>
      <p class="desc">{section.body}</p>
    </div>

    <div class="methods">
      {methods.map(m => (
        <div class="method">
          <span class="num">{m.num}</span>
          <div class="method-body">
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
            <pre>{m.code}</pre>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .connect {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .header {
    max-width: 520px;
    margin-bottom: 3.5rem;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 0.75rem;
  }

  .header h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--text-4);
    line-height: 1.6;
  }

  .methods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .method {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    transition: border-color 0.15s;
  }

  .method:hover {
    border-color: var(--border-strong);
  }

  .num {
    font-size: 0.75rem;
    font-weight: 700;
    font-family: ui-monospace, monospace;
    color: var(--accent);
    letter-spacing: 0.04em;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .method-body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .method-body h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-2);
    letter-spacing: -0.01em;
  }

  .method-body p {
    font-size: 0.875rem;
    color: var(--text-4);
    line-height: 1.6;
  }

  .method-body pre {
    font-size: 0.75rem;
    padding: 0.625rem 0.75rem;
  }

  @media (max-width: 900px) {
    .methods { grid-template-columns: 1fr; }
  }
</style>
