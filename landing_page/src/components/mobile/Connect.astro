---
import CopyCode from "../CopyCode.astro";
import type { MobileConnectSection } from "../../content/pageTypes";

interface Props {
  section: MobileConnectSection;
}

const { section } = Astro.props;
const methods = Array.isArray(section.methods) ? section.methods : [];
---

<section class="border-t border-line py-[4.75rem]" id="connect">
  <div class="mx-auto max-w-[1100px] px-6">
    <div class="mb-11 max-w-[520px]">
      {section.eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.eyebrow}</p>}
      <h2 class="mb-3 text-[clamp(1.5rem,3.5vw,2rem)] font-bold leading-tight tracking-[-0.02em] text-fg">{section.title}</h2>
      <p class="text-[0.9375rem] leading-relaxed text-fg-4">{section.body}</p>
    </div>

    <div class="grid grid-cols-2 gap-6 max-[900px]:grid-cols-1">
      {methods.map((m, index) => (
        <div class:list={[
          "flex min-w-0 gap-4 rounded-xl border border-line bg-raised p-6 transition-colors hover:border-line-strong",
          index === 2 && "col-span-2 max-[900px]:col-span-1",
        ]}>
          <span class="shrink-0 pt-[0.1rem] font-mono text-xs font-bold tracking-[0.04em] text-accent">{m.num}</span>
          <div class="flex min-w-0 flex-col gap-2.5">
            <h3 class="text-[0.9375rem] font-semibold tracking-[-0.01em] text-fg-2">{m.title}</h3>
            <p class="text-sm leading-relaxed text-fg-4">{m.desc}</p>
            <CopyCode code={m.code} language="command" className="mt-1 w-full min-w-0 max-w-full" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
