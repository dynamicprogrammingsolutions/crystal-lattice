---

<section class="hero">
  <div class="container">
    <div class="text-col">
      <p class="label">Crystal Lattice Control</p>
      <h1>Your AI agents,<br />in your pocket</h1>
      <p class="subtitle">
        The official iOS and Android companion for Crystal Lattice. Browse sessions, send messages,
        watch responses stream in real time, manage plugins and settings,
        all from your phone on your own server.
      </p>

      <div class="platforms">
        <span class="platform-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          iOS
        </span>
        <span class="platform-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.523 15.341l1.26 2.183a.5.5 0 0 1-.183.683.5.5 0 0 1-.683-.183l-1.276-2.21A7.99 7.99 0 0 1 12 17a7.99 7.99 0 0 1-4.641-1.186l-1.276 2.21a.5.5 0 0 1-.683.183.5.5 0 0 1-.183-.683l1.26-2.183C4.948 13.9 4 11.837 4 9.5h16c0 2.337-.948 4.4-2.477 5.841zM8.5 12a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zm7 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zM6.225 5.985l-1.26-2.183a.5.5 0 0 1 .866-.5l1.276 2.21A7.99 7.99 0 0 1 12 4a7.99 7.99 0 0 1 4.893 1.512l1.276-2.21a.5.5 0 0 1 .866.5l-1.26 2.183C19.052 7.1 20 9.163 20 11.5H4c0-2.337.948-4.4 2.225-5.515z"/>
          </svg>
          Android
        </span>
      </div>

      <div class="download-btns">
        <a href="#" class="store-btn app-store">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          <div class="store-text">
            <span class="store-sub">Download on the</span>
            <span class="store-name">App Store</span>
          </div>
        </a>
        <a href="#" class="store-btn play-store">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5c.6.37.6 1.23 0 1.6l-14 8.5c-.66.5-1.6.03-1.6-.8z"/>
          </svg>
          <div class="store-text">
            <span class="store-sub">Get it on</span>
            <span class="store-name">Google Play</span>
          </div>
        </a>
      </div>

      <p class="free-note">Free · Requires a Crystal Lattice server</p>
    </div>

    <div class="phone-col">
      <div class="bubbles-wrap">
        <div class="bubble b1"></div>
        <div class="bubble b2"></div>
        <div class="bubble b3"></div>
        <div class="phone-frame">
          <img
            src="/cl-mobile-frame.png"
            alt="Crystal Lattice Control mobile app"
            class="phone-img"
            onerror="this.closest('.phone-col').style.display='none';"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: center;
  }

  .text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .subtitle {
    font-size: 1rem;
    color: var(--text-4);
    line-height: 1.65;
    max-width: 480px;
  }

  .platforms {
    display: flex;
    gap: 0.5rem;
  }

  .platform-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-4);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.25rem 0.625rem;
  }

  .download-btns {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1.125rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text);
    transition: border-color 0.15s, background 0.15s;
    cursor: pointer;
  }

  .store-btn:hover {
    border-color: var(--border-strong);
    background: var(--bg-surface-2);
    color: var(--text);
  }

  .store-text {
    display: flex;
    flex-direction: column;
  }

  .store-sub {
    font-size: 0.6875rem;
    color: var(--text-4);
    line-height: 1;
  }

  .store-name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .free-note {
    font-size: 0.8125rem;
    color: var(--text-5);
  }

  /* Phone + bubbles */
  .phone-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bubbles-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .bubble {
    position: absolute;
    border-radius: 50%;
    filter: blur(52px);
    opacity: 0.28;
    pointer-events: none;
  }

  .b1 {
    width: 200px;
    height: 200px;
    background: #6366f1;
    top: 8%;
    left: -5%;
    animation: blob1 10s ease-in-out infinite;
  }

  .b2 {
    width: 160px;
    height: 160px;
    background: #8b5cf6;
    bottom: 5%;
    right: -8%;
    animation: blob2 13s ease-in-out infinite;
  }

  .b3 {
    width: 130px;
    height: 130px;
    background: #06b6d4;
    top: 52%;
    left: 38%;
    animation: blob3 9s ease-in-out infinite;
  }

  @keyframes blob1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(24px, -28px) scale(1.06); }
    66%       { transform: translate(-18px, 14px) scale(0.94); }
  }

  @keyframes blob2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(-20px, 22px) scale(1.08); }
    70%       { transform: translate(12px, -12px) scale(0.96); }
  }

  @keyframes blob3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%       { transform: translate(16px, 20px) scale(1.05); }
  }

  .phone-frame {
    width: 100%;
    max-width: 280px;
    position: relative;
    z-index: 1;
  }

  .phone-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 860px) {
    .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .text-col { align-items: center; }
    .subtitle { margin: 0 auto; }

    .phone-col { order: -1; }

    .phone-frame {
      max-width: 240px;
    }
  }
</style>
