---
import CopyCode from "./CopyCode.astro";
import type { QuickstartSection } from "../content/pageTypes";

interface Props {
  section: QuickstartSection;
}

const { section } = Astro.props;
const steps = Array.isArray(section.steps) ? section.steps : [];
---

<section class="border-t border-line py-[4.75rem]" id="quickstart">
  <div class="mx-auto max-w-[1100px] px-6">
    <div class="mb-10 max-w-[520px]">
      {section.eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.eyebrow}</p>}
      <h2 class="mb-2.5 text-[clamp(1.5rem,3.5vw,2rem)] font-bold tracking-[-0.02em] text-fg">{section.title}</h2>
      <p class="text-[0.9375rem] text-fg-4">{section.body}</p>
    </div>

    <div class="flex flex-col gap-6">
      {steps.map((step) => (
        <div class="flex flex-col gap-3 rounded-xl border border-line bg-raised p-7 [&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-fg-4 [&_strong]:font-semibold [&_strong]:text-fg-3">
          <div class="mb-1 flex items-center gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-bold text-white">{step.num}</span>
            <h3 class="text-[0.9375rem] font-semibold text-fg-2">{step.title}</h3>
          </div>
          {(step.body ?? []).map((block) => <p set:html={block.html} />)}
          {(step.codeBlocks ?? []).map((code) => <CopyCode code={code} language="command" className="mt-1" />)}
          {(step.after ?? []).map((block) => <p set:html={block.html} />)}
          {(step.afterCodeBlocks ?? []).map((code) => <CopyCode code={code} language="command" className="mt-1" />)}
        </div>
      ))}
    </div>
  </div>
</section>
