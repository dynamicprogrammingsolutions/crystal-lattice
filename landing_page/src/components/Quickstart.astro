---
const { section } = Astro.props;
const steps = Array.isArray(section.steps) ? section.steps : [];
---

<section class="quickstart" id="quickstart">
  <div class="container">
    <div class="header">
      <p class="label">{section.eyebrow}</p>
      <h2>{section.title}</h2>
      <p class="desc">{section.body}</p>
    </div>

    <div class="steps">
      {steps.map((step) => (
        <div class="step">
          <div class="step-header">
            <span class="step-num">{step.num}</span>
            <h3>{step.title}</h3>
          </div>
          {(step.body ?? []).map((block) => <p set:html={block.html} />)}
          {(step.codeBlocks ?? []).map((code) => <pre>{code}</pre>)}
          {(step.after ?? []).map((block) => <p set:html={block.html} />)}
          {(step.afterCodeBlocks ?? []).map((code) => <pre>{code}</pre>)}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .quickstart {
    padding: 5.5rem 0;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .header {
    max-width: 520px;
    margin-bottom: 3rem;
  }

  .label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 0.75rem;
  }

  .header h2 {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.625rem;
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--text-4);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .step-num {
    width: 24px;
    height: 24px;
    background: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }

  .step h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .step p {
    font-size: 0.875rem;
    color: var(--text-4);
    line-height: 1.6;
  }

  .step strong {
    color: var(--text-3);
    font-weight: 600;
  }

  .step pre {
    font-size: 0.75rem;
    padding: 0.75rem 0.875rem;
  }

</style>
