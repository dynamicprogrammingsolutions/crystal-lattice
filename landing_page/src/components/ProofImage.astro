---
import ThemedImage from "./ThemedImage.astro";
import type { FeatureMediaAsset } from "../content/pageTypes";

interface Props {
  asset: FeatureMediaAsset;
  alt?: string;
  wide?: boolean;
}

const { asset, alt = asset.alt ?? asset.label ?? "", wide = false } = Astro.props;
---

<div
  class:list={["proof-frame", wide && "proof-frame--wide"]}
  data-proof-frame
  data-proof-media={asset.src ? "" : undefined}
  data-proof-placeholder={!asset.src ? "" : undefined}
>
  {asset.src ? (
    <ThemedImage
      src={asset.src}
      srcDark={asset.srcDark}
      alt={alt}
      width={asset.width}
      height={asset.height}
    />
  ) : (
    <div class="proof-placeholder">
      <span class="font-mono text-[0.6875rem] uppercase tracking-[0.08em] text-fg-5">
        Planned visual
      </span>
      <p class="text-sm leading-relaxed text-fg-4">{asset.placeholder}</p>
    </div>
  )}
</div>

<style>
  .proof-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: #0b0d10;
  }
  :global([data-theme="light"]) .proof-frame { background: #f3f4f7; }
  .proof-frame :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .proof-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
  }
  .proof-placeholder p { max-width: 640px; }
  @media (min-width: 761px) {
    .proof-frame--wide { aspect-ratio: 16 / 9; }
  }
</style>