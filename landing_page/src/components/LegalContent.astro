---
import type { LegalContentSection } from "../content/pageTypes";

interface Props {
  section: LegalContentSection;
}

const { section } = Astro.props;
const legalSections = Array.isArray(section.sections) ? section.sections : [];
---

<main class="py-20 pb-24">
  <div class="mx-auto max-w-[680px] px-6">
    <div class="mb-12 border-b border-line pb-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.label}</p>
      <h1 class="mb-2 text-[clamp(1.75rem,4vw,2.5rem)] font-bold tracking-[-0.03em] text-fg">{section.title}</h1>
      <p class="text-sm text-fg-5">{section.meta}</p>
    </div>

    <div class="flex flex-col gap-10 [&_a]:text-accent-soft [&_a]:transition-colors [&_a:hover]:text-accent-pale">
      {legalSections.map((item) => (
        <section>
          <h2 class="mb-3 text-[1.0625rem] font-semibold tracking-[-0.01em] text-fg-2">{item.title}</h2>
          {(item.blocks ?? []).map((block) => (
            <>
              {block.type === "paragraph" && <p class="mb-3 text-[0.9375rem] leading-[1.7] text-fg-4 last:mb-0" set:html={block.html} />}
              {block.type === "list" && (
                <ul class="mt-2 flex flex-col gap-2.5">
                  {(block.items ?? []).map((listItem) => <li class="relative pl-5 text-[0.9375rem] leading-[1.65] text-fg-4 before:absolute before:left-0 before:text-line-strong before:content-['—']" set:html={listItem} />)}
                </ul>
              )}
            </>
          ))}
        </section>
      ))}
    </div>
  </div>
</main>
