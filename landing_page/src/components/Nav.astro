---
import { docsUrl } from '../config/publicUrls';
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <img src="/icon_dark.svg" alt="Crystal Lattice" width="22" height="22" class="logo-dark" />
      <img src="/icon.svg" alt="Crystal Lattice" width="22" height="22" class="logo-light" />
      <span>Crystal Lattice</span>
    </a>

    <nav class="nav-links">
      <a href="/#features" class="nav-link" data-section="features">Features</a>
      <a href="/mobile" class="nav-link" data-section="mobile">Mobile App</a>
      <a href="/#quickstart" class="nav-link" data-section="quickstart">Quickstart</a>
      <a href={`${docsUrl}/`} target="_blank" rel="noopener">Docs</a>
    </nav>

    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" class="btn-ghost" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a href="/#quickstart" class="btn-primary">Get Started</a>
    </div>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const html = document.documentElement;
    const btn = document.getElementById('themeToggle');

    if (btn) {
      btn.removeEventListener('click', handleThemeToggle);
      btn.addEventListener('click', handleThemeToggle);
    }
  }

  function handleThemeToggle() {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('cl-theme', next);
    const favicon = document.querySelector('link[rel="icon"]');
    if (favicon) favicon.href = next === 'dark' ? '/icon_dark.svg' : '/icon.svg';
  }

  function setupScrollSpy() {
    const links = document.querySelectorAll('.nav-link');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.remove('active');
            });
            const activeLink = document.querySelector(
              `.nav-link[data-section="${entry.target.id}"]`
            );
            if (activeLink) activeLink.classList.add('active');
          }
        });
      },
      { threshold: 0.5 }
    );

    const sections = document.querySelectorAll('[id="features"], [id="quickstart"]');
    sections.forEach((section) => observer.observe(section));

    // Check current path for mobile
    if (window.location.pathname === '/mobile') {
      links.forEach((link) => link.classList.remove('active'));
      const mobileLink = document.querySelector('.nav-link[data-section="mobile"]');
      if (mobileLink) mobileLink.classList.add('active');
    }
  }

  setupThemeToggle();
  setupScrollSpy();
  document.addEventListener('astro:after-swap', () => {
    setupThemeToggle();
    setupScrollSpy();
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    flex-shrink: 0;
  }

  .nav-logo img { border-radius: 5px; }
  .logo-dark, .logo-light { display: none; }

  :global([data-theme="dark"])  .logo-dark  { display: block; }
  :global([data-theme="light"]) .logo-light { display: block; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    color: var(--text-3);
    transition: color 0.15s;
  }

  .nav-links a:hover { color: var(--text); }

  .nav-links a.active {
    color: var(--accent);
    font-weight: 500;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Theme toggle */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--bg-surface);
  }

  /* Hide both by default; show the correct one per theme */
  .icon-sun, .icon-moon { display: none; }

  :global([data-theme="dark"])  .icon-sun  { display: block; }
  :global([data-theme="light"]) .icon-moon { display: block; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-3);
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
  }

  .btn-ghost:hover {
    color: var(--text);
    background: var(--bg-surface);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #fff;
    background: var(--accent);
    border-radius: 0.375rem;
    transition: background 0.15s;
  }

  .btn-primary:hover { background: var(--accent-hover); }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-inner { padding: 0 1rem; }
  }

  @media (max-width: 480px) {
    .btn-primary { display: none; }
  }
</style>
