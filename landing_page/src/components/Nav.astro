---
import { docsUrl } from "../config/publicUrls";
import { loadDesktopRelease } from "../content/loadDesktopRelease";

const desktopRelease = loadDesktopRelease();
---

<header
  class="sticky top-0 z-50 border-b border-line bg-[var(--nav-bg)] backdrop-blur-md transition-colors"
>
  <div
    class="mx-auto flex h-14 max-w-[1100px] items-center justify-between gap-8 px-6 max-sm:gap-2 max-sm:px-4 max-[360px]:gap-1 max-[360px]:px-3"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-[0.9375rem] font-semibold text-fg max-[360px]:gap-1 max-[360px]:text-sm"
    >
      <img
        src="/icon_dark.svg"
        alt="Crystal Lattice"
        width="22"
        height="22"
        class="hidden rounded-[5px] dark:block"
      />
      <img
        src="/icon.svg"
        alt="Crystal Lattice"
        width="22"
        height="22"
        class="hidden rounded-[5px] light:block"
      />
      <span>Crystal Lattice</span>
    </a>

    <nav class="flex items-center gap-7 max-[900px]:hidden">
      <a
        href="/#getting-started"
        class="nav-link text-sm text-fg-3 transition-colors hover:text-fg aria-[current=true]:font-medium aria-[current=true]:text-accent"
        data-section="getting-started">Get started</a
      >
      <a
        href="/#model-native-harnesses"
        class="nav-link text-sm text-fg-3 transition-colors hover:text-fg aria-[current=true]:font-medium aria-[current=true]:text-accent"
        data-section="model-native-harnesses">Harnesses</a
      >
      <a
        href="/#feature-plugins"
        class="nav-link text-sm text-fg-3 transition-colors hover:text-fg aria-[current=true]:font-medium aria-[current=true]:text-accent"
        data-section="feature-plugins">Plugins</a
      >
      <a
        href="/mobile"
        class="nav-link text-sm text-fg-3 transition-colors hover:text-fg aria-[current=true]:font-medium aria-[current=true]:text-accent"
        data-section="mobile">Mobile App</a
      >
      <a
        href={docsUrl}
        aria-label="Documentation"
        class="text-sm text-fg-3 transition-colors hover:text-fg">Docs</a
      >
    </nav>

    <div class="flex shrink-0 items-center gap-2 max-[360px]:gap-1">
      <button
        class="inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md border border-line bg-transparent text-fg-3 transition-colors hover:border-line-strong hover:bg-surface hover:text-fg"
        id="themeToggle"
        aria-label="Toggle theme"
      >
        <svg
          class="hidden dark:block"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="5"></circle><line
            x1="12"
            y1="1"
            x2="12"
            y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line
            x1="18.36"
            y1="18.36"
            x2="19.78"
            y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line><line
            x1="21"
            y1="12"
            x2="23"
            y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line
            x1="18.36"
            y1="5.64"
            x2="19.78"
            y2="4.22"></line>
        </svg>
        <svg
          class="hidden light:block"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a
        href={desktopRelease.dmg.url}
        aria-label="Download Crystal Lattice Desktop for macOS"
        title={`Download Crystal Lattice Desktop ${desktopRelease.version} for macOS`}
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line bg-transparent text-fg-3 transition-colors hover:border-line-strong hover:bg-surface hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
        data-desktop-download
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M5 21h14"></path>
        </svg>
      </a>
      <a
        href={docsUrl}
        aria-label="Documentation"
        class="hidden items-center rounded-md px-2.5 py-1.5 text-sm font-medium text-fg-3 transition-colors hover:bg-surface hover:text-fg max-[900px]:inline-flex max-[360px]:px-1"
      >
        Docs
      </a>
      <a
        href="https://github.com/dynamicprogrammingsolutions/crystal-lattice"
        class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-fg-3 transition-colors hover:bg-surface hover:text-fg max-[900px]:hidden"
        target="_blank"
        rel="noopener"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href="/#getting-started"
        class="inline-flex items-center rounded-md bg-accent px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover max-[360px]:px-2"
        >Start</a
      >
    </div>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const html = document.documentElement;
    const btn = document.getElementById("themeToggle");

    if (btn) {
      btn.removeEventListener("click", handleThemeToggle);
      btn.addEventListener("click", handleThemeToggle);
    }
  }

  function handleThemeToggle() {
    const html = document.documentElement;
    const next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
    html.setAttribute("data-theme", next);
    localStorage.setItem("cl-theme", next);
    const favicon = document.querySelector('link[rel="icon"]');
    if (favicon)
      favicon.href = next === "dark" ? "/icon_dark.svg" : "/icon.svg";
  }

  function setupScrollSpy() {
    const links = document.querySelectorAll(".nav-link");
    const clear = () =>
      links.forEach((link) => link.removeAttribute("aria-current"));
    const mark = (section) => {
      const activeLink = document.querySelector(
        `.nav-link[data-section="${section}"]`,
      );
      if (activeLink) activeLink.setAttribute("aria-current", "true");
    };
    const sections = Array.from(
      document.querySelectorAll(
        '[id="getting-started"], [id="feature-plugins"], [id="model-native-harnesses"]',
      ),
    );
    let ticking = false;

    const normalizedPath = window.location.pathname.replace(/\/+$/, "") || "/";

    // Mobile route has no home-page scroll sections; mark it and stop.
    if (normalizedPath === "/mobile") {
      clear();
      mark("mobile");
      return;
    }

    if (sections.length === 0) {
      clear();
      return;
    }

    const updateActiveSection = (preferHash = false) => {
      ticking = false;

      if (preferHash && window.location.hash) {
        const hashSection = window.location.hash.slice(1);
        if (sections.some((section) => section.id === hashSection)) {
          clear();
          mark(hashSection);
          return;
        }
      }

      const activationOffset = 72;
      const activeSection = sections.reduce((current, section) => {
        return section.getBoundingClientRect().top <= activationOffset
          ? section
          : current;
      }, sections[0]);

      if (activeSection) {
        clear();
        mark(activeSection.id);
      }
    };

    const requestActiveSectionUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => updateActiveSection());
    };

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const section = link.getAttribute("data-section");
        if (!section || section === "mobile") return;
        clear();
        mark(section);
      });
    });

    window.addEventListener("scroll", requestActiveSectionUpdate, {
      passive: true,
    });
    window.addEventListener("hashchange", () => updateActiveSection(true));
    updateActiveSection(true);
  }

  setupThemeToggle();
  setupScrollSpy();
  document.addEventListener("astro:after-swap", () => {
    setupThemeToggle();
    setupScrollSpy();
  });
</script>
