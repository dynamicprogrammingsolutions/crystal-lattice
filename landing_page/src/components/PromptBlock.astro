---
import CopyCode from "./CopyCode.astro";
import SectionShell from "./SectionShell.astro";
import type { PromptBlockSection } from "../content/pageTypes";

interface Props {
  section: PromptBlockSection;
}

const { section } = Astro.props;
---

<SectionShell id={section.id}>
  <div class="grid grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] items-start gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-8">
    <div class="flex flex-col gap-3.5">
      {section.eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.eyebrow}</p>}
      <h2 class="text-[clamp(1.5rem,3.5vw,2rem)] font-bold leading-tight tracking-[-0.02em] text-fg">{section.title}</h2>
      <p class="text-[0.9375rem] leading-relaxed text-fg-4">{section.intro}</p>
    </div>

    <div class="min-w-0 overflow-hidden rounded-xl border border-line bg-raised">
      <CopyCode code={section.prompt} language="prompt" className="m-4" />
      {section.configExample?.code && (
        <div class="border-t border-line p-4">
          <CopyCode code={section.configExample.code} language={section.configExample.language ?? "config"} />
        </div>
      )}
    </div>
  </div>
</SectionShell>
