---
interface Props {
  src: string;
  srcDark?: string;
  srcCompact?: string;
  srcCompactDark?: string;
  widthCompact?: number;
  heightCompact?: number;
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  dataKind?: string;
}

const {
  src,
  srcDark,
  srcCompact,
  srcCompactDark,
  widthCompact,
  heightCompact,
  alt,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  class: className,
  dataKind,
} = Astro.props;
const isThemed = Boolean(srcDark);
---

<picture>
{srcCompact && (
  <source
    media="(max-width: 760px)"
    srcset={srcCompactDark ? undefined : srcCompact}
    data-theme-light-srcset={srcCompactDark ? srcCompact : undefined}
    data-theme-dark-srcset={srcCompactDark}
    width={widthCompact}
    height={heightCompact}
  />
)}
<img
  src={isThemed ? undefined : src}
  data-theme-light-src={isThemed ? src : undefined}
  data-theme-dark-src={isThemed ? srcDark : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  class={className}
  data-kind={dataKind}
/>
</picture>
{isThemed && (
  <noscript>
    <picture>
    {srcCompact && (
      <source media="(max-width: 760px)" srcset={srcCompact} width={widthCompact} height={heightCompact} />
    )}
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding={decoding}
      class={className}
      data-kind={dataKind}
    />
    </picture>
  </noscript>
)}