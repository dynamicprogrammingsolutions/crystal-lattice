---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a href="/" class="logo">
          <img src="/icon.svg" alt="" width="20" height="20" class="rounded" />
          Crystal Lattice
        </a>
        <p>Plugin-driven AI agent workspace for your computer, phone, and custom workflows.</p>
      </div>

      <div class="links-group">
        <div class="link-col">
          <h4>Product</h4>
          <ul>
            <li><a href="/#quickstart">CLI &amp; App UI</a></li>
            <li><a href="/mobile">Mobile App</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4>Developers</h4>
          <ul>
            <li><a href="/#quickstart">Quickstart</a></li>
            <li><a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener">GitHub</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4>Legal</h4>
          <ul>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Use</a></li>
            <li><a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener">Repository licenses</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} Crystal Lattice. Source available on GitHub.</p>
      <div class="bottom-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .brand {
    max-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .logo img {
    border-radius: 4px;
  }

  .brand p {
    font-size: 0.8125rem;
    color: var(--text-5);
    line-height: 1.6;
  }

  .links-group {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .link-col h4 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-5);
    margin-bottom: 0.875rem;
  }

  .link-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link-col ul a {
    font-size: 0.875rem;
    color: var(--text-4);
    transition: color 0.15s;
  }

  .link-col ul a:hover {
    color: var(--text-3);
  }

  .bottom {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .bottom p {
    font-size: 0.8125rem;
    color: var(--text-5);
  }

  .bottom-links {
    display: flex;
    gap: 1.25rem;
  }

  .bottom-links a {
    font-size: 0.8125rem;
    color: var(--text-5);
    transition: color 0.15s;
  }

  .bottom-links a:hover {
    color: var(--text-3);
  }

  @media (max-width: 700px) {
    .links-group { gap: 2rem; }
    .bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
