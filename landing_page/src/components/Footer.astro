---
import { docsUrl } from "../config/publicUrls";

const year = new Date().getFullYear();
---

<footer class="border-t border-line pb-8 pt-14">
  <div class="mx-auto max-w-[1100px] px-6">
    <div class="mb-12 flex flex-wrap justify-between gap-12">
      <div class="flex max-w-[240px] flex-col gap-2">
        <a href="/" class="inline-flex items-center gap-2 text-[0.9375rem] font-semibold text-fg">
          <img src="/icon_dark.svg" alt="" width="20" height="20" class="hidden rounded dark:block" />
          <img src="/icon.svg" alt="" width="20" height="20" class="hidden rounded light:block" />
          <span>Crystal Lattice</span>
        </a>
        <p class="text-[0.8125rem] leading-relaxed text-fg-5">Plugin-driven AI agent workspace for your computer, phone, and custom workflows.</p>
      </div>

      <div class="flex flex-wrap gap-x-14 gap-y-8 max-[700px]:gap-8">
        <div>
          <h4 class="mb-3.5 text-xs font-semibold uppercase tracking-[0.06em] text-fg-5">Product</h4>
          <ul class="flex flex-col gap-2">
            <li><a href="/#computer-to-phone" class="text-sm text-fg-4 transition-colors hover:text-fg-3">CLI &amp; App UI</a></li>
            <li><a href="/mobile" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Mobile App</a></li>
            <li><a href="/support" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Support</a></li>
          </ul>
        </div>

        <div>
          <h4 class="mb-3.5 text-xs font-semibold uppercase tracking-[0.06em] text-fg-5">Developers</h4>
          <ul class="flex flex-col gap-2">
            <li><a href="/#computer-to-phone" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Start workspace</a></li>
            <li><a href={docsUrl} class="text-sm text-fg-4 transition-colors hover:text-fg-3">Documentation</a></li>
            <li><a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener" class="text-sm text-fg-4 transition-colors hover:text-fg-3">GitHub</a></li>
          </ul>
        </div>

        <div>
          <h4 class="mb-3.5 text-xs font-semibold uppercase tracking-[0.06em] text-fg-5">Legal</h4>
          <ul class="flex flex-col gap-2">
            <li><a href="/privacy" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Privacy Policy</a></li>
            <li><a href="/terms" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Terms of Use</a></li>
            <li><a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener" class="text-sm text-fg-4 transition-colors hover:text-fg-3">Repository licenses</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 max-[700px]:flex-col max-[700px]:items-start">
      <p class="text-[0.8125rem] text-fg-5">© {year} Crystal Lattice. Source available on GitHub.</p>
      <div class="flex gap-5">
        <a href="/support" class="text-[0.8125rem] text-fg-5 transition-colors hover:text-fg-3">Support</a>
        <a href="/privacy" class="text-[0.8125rem] text-fg-5 transition-colors hover:text-fg-3">Privacy</a>
        <a href="/terms" class="text-[0.8125rem] text-fg-5 transition-colors hover:text-fg-3">Terms</a>
        <a href="https://github.com/dynamicprogrammingsolutions/crystal-lattice" target="_blank" rel="noopener" class="text-[0.8125rem] text-fg-5 transition-colors hover:text-fg-3">GitHub</a>
      </div>
    </div>
  </div>
</footer>
