---
import HighlightCode from "./HighlightCode.astro";
import SectionShell from "./SectionShell.astro";
import type { CodeExampleSection } from "../content/pageTypes";

interface Props {
  section: CodeExampleSection;
}

const { section } = Astro.props;
const body = Array.isArray(section.body) ? section.body : [];
---

<SectionShell id={section.id}>
  <div class="grid grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] items-start gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-8">
    <div class="flex flex-col gap-3.5">
      {section.eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.eyebrow}</p>}
      <h2 class="text-[clamp(1.5rem,3.5vw,2rem)] font-bold leading-tight tracking-[-0.02em] text-fg">{section.title}</h2>
      {body.map((paragraph) => <p class="text-[0.9375rem] leading-relaxed text-fg-4">{paragraph}</p>)}
      {section.code?.status && (
        <span class="w-fit rounded-full border border-line bg-raised px-3 py-1.5 font-mono text-[0.72rem] text-fg-3">{section.code.status}</span>
      )}
    </div>

    <div class="min-w-0 overflow-hidden rounded-xl border border-line bg-raised">
      <HighlightCode code={section.code?.value ?? ""} language={section.code?.language ?? "plaintext"} className="m-4" />
    </div>
  </div>
</SectionShell>
