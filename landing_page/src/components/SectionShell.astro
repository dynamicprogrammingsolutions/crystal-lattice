---
interface Props {
  id?: string;
  tone?: "default" | "alt";
  spacing?: "normal" | "compact" | "flush-top";
  border?: boolean;
  innerClass?: string;
}

const {
  id,
  tone = "default",
  spacing = "normal",
  border = true,
  innerClass = "",
} = Astro.props;
---

<section
  id={id}
  class:list={[
    border && "border-t border-line",
    spacing === "compact"
      ? "py-7 max-sm:py-6"
      : spacing === "flush-top"
        ? "pb-[4.75rem] pt-0 max-sm:pb-14"
        : "py-[4.75rem] max-sm:py-14",
    tone === "alt" && "bg-canvas-alt",
  ]}
>
  <div class:list={["mx-auto max-w-[1100px] px-6", innerClass]}>
    <slot />
  </div>
</section>
