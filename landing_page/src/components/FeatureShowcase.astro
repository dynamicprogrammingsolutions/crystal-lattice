---
import SectionShell from "./SectionShell.astro";
import FeatureMedia from "./FeatureMedia.astro";
import ThemedImage from "./ThemedImage.astro";
import type { FeatureShowcaseSection } from "../content/pageTypes";

interface Props {
  section: FeatureShowcaseSection;
}

const { section } = Astro.props;
const body = Array.isArray(section.body) ? section.body : [];
const items = Array.isArray(section.items) ? section.items : [];
const visual = section.visual && typeof section.visual === "object" ? section.visual : null;
const isEditorial = section.presentation === "editorial";
const gridClass =
  isEditorial
    ? "grid-cols-2 max-[760px]:grid-cols-1"
    : section.layout === "three-column"
    ? "grid-cols-3 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1"
    : "grid-cols-2 max-[700px]:grid-cols-1";
---

<SectionShell
  id={section.id}
  border={!isEditorial}
  spacing={isEditorial ? "flush-top" : "normal"}
>
  {!isEditorial && (
    <div class="mb-11 max-w-[720px]">
      {section.eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.08em] text-accent-soft">{section.eyebrow}</p>}
      <h2 class="mb-3 text-[clamp(1.5rem,3.5vw,2rem)] font-bold leading-tight tracking-[-0.02em] text-fg">{section.title}</h2>
      {body.map((paragraph) => <p class="mb-3 text-[0.9375rem] leading-relaxed text-fg-4">{paragraph}</p>)}
      {section.reviewStatus && (
        <p class="mt-4 inline-flex rounded-full border border-line bg-raised px-3 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-fg-5">
          {section.reviewStatus}
        </p>
      )}
    </div>
  )}

  <div class:list={["grid gap-6", gridClass]} data-feature-showcase-grid>
    {items.map((item) => (
      <article
        id={item.id}
        class:list={[
          "feature-item flex min-w-0 flex-col gap-4",
          isEditorial
            ? "feature-item--editorial"
            : "rounded-xl border border-line bg-raised p-5",
          item.layout === "full-width" && "feature-item--wide",
        ]}
        data-feature-highlight
        data-feature-layout={item.layout ?? "compact"}
        data-review-status={item.reviewStatus}
      >
        <div class="feature-copy">
          <h3 class:list={[
            "font-bold leading-[1.08] tracking-[-0.03em] text-fg",
            isEditorial
              ? "text-[clamp(1.65rem,3vw,2.4rem)]"
              : "text-[0.9375rem] text-fg-2",
          ]}>{item.title}</h3>
          <p class:list={[
            "mt-4 leading-relaxed",
            isEditorial
              ? "max-w-[820px] text-[1rem] text-fg-3"
              : "text-sm leading-snug text-fg-4",
          ]}>{item.description}</p>
        </div>

        <div class="feature-proof">
          {item.media && (
            <FeatureMedia
              media={item.media}
              wide={item.layout === "full-width"}
              framed={isEditorial}
            />
          )}
        </div>
      </article>
    ))}
  </div>

  {visual && (
    <div class="mt-6 rounded-xl border border-line bg-raised p-4">
      {visual.status === "placeholder-needed" ? (
        <div class="flex aspect-video w-full flex-col justify-center gap-2 rounded-lg border border-dashed border-line-strong bg-[color-mix(in_srgb,var(--accent)_6%,transparent)] p-5">
          <span class="font-mono text-[0.8125rem] text-accent-pale">{visual.src}</span>
          <p class="max-w-[560px] text-sm leading-snug text-fg-4">{visual.alt}</p>
        </div>
      ) : (
        <ThemedImage
          src={visual.src}
          srcDark={visual.srcDark}
          alt={visual.alt ?? section.title}
          width={visual.width}
          height={visual.height}
          loading="lazy"
          decoding="async"
          class="block aspect-video w-full rounded-lg border border-line object-cover"
        />
      )}
    </div>
  )}
</SectionShell>

<style>
  .feature-proof { min-width: 0; align-self: start; }
  .feature-item--wide { grid-column: 1 / -1; }
  @supports (grid-template-rows: subgrid) {
    .feature-item { display: grid; grid-template-rows: subgrid; grid-row: span 2; }
    .feature-item--editorial { grid-row: span 4; }
    .feature-item--editorial .feature-proof {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 3;
      align-self: stretch;
    }
  }
</style>
