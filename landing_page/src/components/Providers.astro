---
import SectionShell from "./SectionShell.astro";
import type { ProvidersSection } from "../content/pageTypes";

interface Props {
  section: ProvidersSection;
}

const { section } = Astro.props;
const providers = Array.isArray(section.providers) ? section.providers : [];
---

<SectionShell id={section.id} tone="alt" spacing="compact">
  <div class="grid grid-cols-[minmax(180px,0.28fr)_1fr] items-center gap-x-8 gap-y-4 max-[760px]:grid-cols-1 max-[760px]:items-start">
    <p class="text-xs font-semibold uppercase leading-snug tracking-[0.06em] text-fg-5">{section.label}</p>
    <div class="flex flex-wrap items-center gap-2.5">
      {providers.map(p => (
        <span class="rounded-lg border border-line bg-surface px-3 py-2 text-[0.8125rem] font-medium leading-tight text-fg-4">{p}</span>
      ))}
    </div>
  </div>
</SectionShell>
