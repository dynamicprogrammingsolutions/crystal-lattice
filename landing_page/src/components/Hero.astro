---
import InstallationChooser from "./InstallationChooser.astro";
import type { HeroSection } from "../content/pageTypes";

interface Props {
  section: HeroSection;
}

const { section } = Astro.props;
const actions = Array.isArray(section.actions) ? section.actions : [];
const install = section.install;
const btnBase = "inline-flex items-center gap-1.5 rounded-lg px-5 py-2.5 text-[0.9375rem] font-medium transition-colors";
const btnClass: Record<string, string> = {
  primary: `${btnBase} bg-accent text-white hover:bg-accent-hover hover:text-white`,
  outline: `${btnBase} border border-line bg-transparent text-fg-3 hover:border-line-strong hover:text-fg`,
};
const icons: Record<string, string> = {
  arrow: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`,
  github: `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
};
---

<section id={section.id} class="pb-10 pt-24 text-center max-sm:pb-8 max-sm:pt-16">
  <div class="mx-auto flex max-w-[820px] flex-col items-center gap-6 px-6">
    {section.badge && <div class="inline-block rounded-full border border-line bg-surface px-3.5 py-1 text-xs font-medium tracking-[0.02em] text-fg-3">{section.badge}</div>}

    <h1 class="text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1.1] tracking-[-0.03em] text-fg" set:html={section.titleHtml} />

    <p class="max-w-[600px] text-[clamp(0.9375rem,2vw,1.0625rem)] leading-[1.65] text-fg-4">{section.subtitle}</p>

    <div class="flex flex-wrap justify-center gap-3">
      {actions.map((action) => (
        <a href={action.href} class={btnClass[action.variant] ?? btnClass.outline} target={action.target} rel={action.target ? "noopener" : undefined}>
          {action.icon === "github" && <Fragment set:html={icons.github} />}
          {action.label}
          {action.icon === "arrow" && <Fragment set:html={icons.arrow} />}
        </a>
      ))}
    </div>

    {install && <InstallationChooser install={install} />}
  </div>
</section>
