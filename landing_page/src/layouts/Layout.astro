---
import { ViewTransitions } from 'astro:transitions';
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import { isStagingSite } from '../../site-variant.mjs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Crystal Lattice: The Open Source AI Agent Platform",
  description = "A local-first, provider-agnostic AI agent platform. Terminal & HTTP server, mobile app, plugin ecosystem, and Python SDK. All on your own hardware.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {isStagingSite && (
    <>
      <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
      <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <title>{title}</title>
  <ViewTransitions />
  {!isStagingSite && <UmamiAnalytics />}
  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    function applyThemeImages(root = document) {
      const theme = document.documentElement.getAttribute('data-theme') === 'light'
        ? 'light'
        : 'dark';
      root
        .querySelectorAll('img[data-theme-light-src][data-theme-dark-src], source[data-theme-light-srcset][data-theme-dark-srcset]')
        .forEach((image) => {
          const attribute = image.tagName === 'SOURCE' ? 'srcset' : 'src';
          const nextSource = theme === 'dark'
            ? image.getAttribute(`data-theme-dark-${attribute}`)
            : image.getAttribute(`data-theme-light-${attribute}`);
          if (nextSource && image.getAttribute(attribute) !== nextSource) {
            image.setAttribute(attribute, nextSource);
          }
        });
    }

    function restoreTheme() {
      const saved = localStorage.getItem('cl-theme');
      const preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      const theme = saved || preferred;
      document.documentElement.setAttribute('data-theme', theme);
      const favicon = document.querySelector('link[rel="icon"]');
      if (favicon) favicon.setAttribute('href', theme === 'dark' ? '/icon_dark.svg' : '/icon.svg');
      applyThemeImages();
    }

    restoreTheme();
    document.addEventListener('DOMContentLoaded', () => applyThemeImages());
    document.addEventListener('astro:after-swap', restoreTheme);
    new MutationObserver(() => applyThemeImages()).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ['data-theme'] },
    );
  </script>
</head>
<body>
  {isStagingSite && (
    <div
      class="bg-amber-400 px-4 py-2 text-center text-xs font-semibold uppercase tracking-[0.08em] text-slate-950"
      data-staging-banner
    >
      Staging preview · Work in progress
    </div>
  )}
  <slot />
</body>
</html>
