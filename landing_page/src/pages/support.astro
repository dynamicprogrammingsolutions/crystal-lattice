---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionRenderer from '../section-system/SectionRenderer.astro';
import { loadPage } from '../content/loadPage';
import { preparePage } from '../section-system/preparePage';

const page = preparePage(loadPage('support'));
---

<Layout title={page.seo?.title} description={page.seo?.description}>
  <Nav />
  <SectionRenderer sections={page.sections} />
  <Footer />
</Layout>