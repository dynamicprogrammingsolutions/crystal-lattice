{
  "schema_version": "1.0.0",
  "generated_at_policy": "Generation timestamps belong in manifests, not individual rows.",
  "stable_id_policy": "Rows use semantic IDs: agent:<agent-id>, provider:<provider-id>, and feature:<normalized-plugin-id>.",
  "delimited_list_separator": "|",
  "status_vocabulary": {
    "capability_state": [
      "current",
      "optional",
      "partial",
      "experimental",
      "planned",
      "unsupported",
      "not_applicable",
      "unknown"
    ],
    "presence_state": [
      "present",
      "absent",
      "unknown"
    ],
    "packaging_state": [
      "selected_source_config",
      "selected_dependency",
      "not_selected",
      "unknown"
    ],
    "enablement_state": [
      "default_enabled",
      "configured_profile",
      "configured_route",
      "optional",
      "default_disabled",
      "conditional",
      "not_applicable",
      "unknown"
    ],
    "support_state": [
      "supported",
      "partial",
      "unsupported",
      "not_applicable",
      "unknown"
    ],
    "verification_state": [
      "passed",
      "failed",
      "incomplete",
      "test_present_not_run",
      "not_applicable",
      "unknown"
    ],
    "review_state": [
