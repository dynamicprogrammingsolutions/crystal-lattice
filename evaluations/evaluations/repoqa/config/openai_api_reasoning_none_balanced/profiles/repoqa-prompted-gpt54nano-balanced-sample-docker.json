{
  "benchmark": "repoqa-prompted",
  "agent_id": "repoqa-prompted-openai-api-reasoning-none",
  "model": "gpt-5.4-nano",
  "runtime_backend": "docker",
  "repeat_count": 3,
  "max_task_restarts": 1,
  "schedule": {
    "window_minutes": 1,
    "tasks_per_window": 1000,
    "max_parallel_tasks": 4
  },
  "paths": {
    "results_root": "results/nano-sample",
    "workspace_root": "workspaces/nano-sample"
  },
  "docker": {
    "enabled": true,
    "image_tag": "agent-evaluations:repoqa"
  }
}