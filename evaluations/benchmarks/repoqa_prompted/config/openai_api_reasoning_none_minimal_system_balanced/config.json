{
  "plugin_cache_dir": "${env:CONFIG_DIR}/.plugin_cache/plugins",
  "mixins": {
    "minimal_developer_message": {
      "system_message_enabled": true,
      "system_message": "You are a developer."
    }
  },
  "plugins": [
    "plugins.tool_gating_feature.ToolGatingFeature",
    "plugins.request_options_feature.RequestOptionsFeature",
    "path:${env:BUILTIN_PLUGINS}/feature-system-message",
    "path:${env:BUILTIN_PLUGINS}/openai_responses"
  ],
  "providers": {
    "openai": {
      "provider": "openai_responses",
      "api_key": "${env:OPENAI_API_KEY}",
      "base_url": "https://api.openai.com/v1",
      "auth_mode": "api",
      "system_message_as_instructions": true,
      "strip_leading_system_or_developer_message": true,
      "enable_flex_processing": true,
      "flex_timeout_seconds": 900,
      "enable_flex_retries": true,
      "flex_max_retries": 8,
      "flex_stream_recovery_mode": "aggressive",
      "flex_stream_recovery_retries": 10,
      "enable_fast_mode": false,
      "reasoning_effort": "none",
      "reasoning_summary": "detailed",
      "show_estimated_cached_tokens": true,
      "show_openai_auth_mode": true
    }
  },
  "agents": {
    "repoqa-prompted-openai-api-minimal-reasoning-none": {
      "mixin_refs": ["minimal_developer_message"],
      "provider": "openai",
      "model": "gpt-5.4-mini",
      "auth_mode": "api"
    }
  },
  "agentic_evaluations": {
    "cache_root": "${env:CONFIG_DIR}/cache",
    "results_root": "${env:CONFIG_DIR}/results",
    "manifests_root": "${env:CONFIG_DIR}/manifests",
    "workspace_root": "${env:CONFIG_DIR}/workspaces",
    "profiles_root": "${env:CONFIG_DIR}/profiles"
  }
}